  },
  "homepage": "https://github.com/Eden-4/SEAL-enclosure#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@sentry/node": "^10.53.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
