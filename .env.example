# Fine-grained PAT with "Repository contents: read" and "Repository administration"/"Actions: write" sufficient to POST /repos/{owner}/{repo}/dispatches.
GITHUB_DISPATCH_TOKEN=
# Target repo in owner/name form, e.g. Eden-4/SEAL-enclosure
GITHUB_REPOSITORY=Eden-4/SEAL-enclosure
